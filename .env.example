# SMTP-notificaties (optioneel) — kopieer naar .env en vul in
SECRET_KEY=een-lange-willekeurige-string
SMTP_HOST=smtp.jouwprovider.nl
SMTP_PORT=587
SMTP_USER=info@bebobetonboren.nl
SMTP_PASS=jouw-wachtwoord
SMTP_FROM=info@bebobetonboren.nl
MAIL_TO=info@bebobetonboren.nl

# Canoniek domein (canonical, OG, sitemap, JSON-LD)
SITE_URL=https://bebobetonboren.nl
# 1 = noindex (staging). Vercel-previews krijgen dit automatisch.
NOINDEX=0
# 1 = toon placeholder-secties (projectcase, logo's, reviews) voor review
SHOW_PLACEHOLDERS=0
# Maximale uploadgrootte per aanvraag in MB (Vercel: max ~4)
MAX_UPLOAD_MB=25
